{
  "expo": {
    "name": "IGF Pilot",
    "slug": "igf-pilot",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "cd.gouv.igf.pilot"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "cd.gouv.igf.pilot"
    },
    "scheme": "cd.gouv.igf.pilot",
    "plugins": [
      "expo-router",
      [
